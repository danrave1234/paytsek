# ---------------------------------------------------------------------------
# PayRecord — environment template
# Copy to `.env` (API) and configure per environment. NEVER commit real values.
# Every value marked [DEPLOYMENT INPUT] must be supplied by the operator; the
# code does not ship fake defaults for them.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Comma-separated allowed CORS origins for web tooling (mobile apps do not need CORS)
API_CORS_ORIGINS=

# --- Supabase ---------------------------------------------------------------
# [DEPLOYMENT INPUT] Project URL, e.g. https://xyz.supabase.co
SUPABASE_URL=
# [DEPLOYMENT INPUT] Anonymous key — safe for mobile clients (RLS-protected)
SUPABASE_ANON_KEY=
# [DEPLOYMENT INPUT] Service-role key — API SERVER ONLY. Never ship to mobile.
SUPABASE_SERVICE_ROLE_KEY=
# [DEPLOYMENT INPUT] JWT secret (Settings -> API) used to verify Supabase Auth tokens server-side
SUPABASE_JWT_SECRET=
# Direct Postgres connection for the API repository layer and worker
# [DEPLOYMENT INPUT] e.g. postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
DATABASE_URL=
DATABASE_POOL_MAX=10

# Private storage buckets (must be created as PRIVATE buckets)
STORAGE_BUCKET_PROOFS=proof-images
STORAGE_BUCKET_EXPORTS=exports
# Signed URL lifetimes (seconds)
STORAGE_SIGNED_UPLOAD_TTL_SECONDS=300
STORAGE_SIGNED_DOWNLOAD_TTL_SECONDS=120

# --- Collector credentials ----------------------------------------------------
# [DEPLOYMENT INPUT] 32+ byte random secret used to HMAC collector credential tokens at rest
COLLECTOR_TOKEN_HASH_SECRET=
PAIRING_CODE_TTL_SECONDS=300
PAIRING_MAX_ATTEMPTS_PER_15MIN=10

# --- Reconciliation ----------------------------------------------------------
MATCH_CANDIDATE_WINDOW_SECONDS=300
MATCH_CAPTURE_TIME_FALLBACK_WINDOW_SECONDS=900
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=8

# --- Billing (RevenueCat) ----------------------------------------------------
# [DEPLOYMENT INPUT] RevenueCat secret API key (server) — used for entitlement reconciliation
REVENUECAT_SECRET_API_KEY=
# [DEPLOYMENT INPUT] Shared "Authorization" header value configured on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH_HEADER=
# Product identifiers (must match App Store Connect / Google Play Console)
BILLING_PRODUCT_SOLO_MONTHLY=payrecord_solo_monthly
BILLING_PRODUCT_TEAM_MONTHLY=payrecord_team_monthly
BILLING_PRODUCT_PACK_500=payrecord_pack_500

# --- Retention (days) --------------------------------------------------------
RETENTION_UNLINKED_EVENTS_DAYS=7
RETENTION_PROOF_IMAGE_FREE_DAYS=30
RETENTION_PROOF_IMAGE_PAID_DAYS=90
RETENTION_RECORDS_MONTHS=12
RETENTION_EXPORT_HOURS=24

# --- Error monitoring --------------------------------------------------------
# [DEPLOYMENT INPUT] Optional Sentry DSN; PII scrubbing is enforced in code regardless
SENTRY_DSN=

# --- Demo / app review -------------------------------------------------------
# When true, the reviewer demo workspace is enabled (isolated from production totals/billing)
DEMO_MODE_ENABLED=false
