{
  "name": "@paytsek/api",
  "version": "0.1.0",
  "private": true,
  "description": "PayTsek API (NestJS): auth, pairing, ingestion, records, reconciliation, billing, exports, worker.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node --watch --env-file=../../.env -r ts-node/register/transpile-only src/main.ts",
    "worker": "node --env-file=../../.env -r ts-node/register/transpile-only src/worker.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@paytsek/contracts": "workspace:*",
    "@paytsek/receipt-parsers": "workspace:*",
    "@sentry/node": "^11.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
