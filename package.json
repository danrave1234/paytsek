{
  "name": "payrecord",
  "private": true,
  "version": "0.1.0",
  "description": "PayRecord — scan a payment proof, keep an organized record, and match it with incoming-payment evidence from your receiving phone.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/api run build",
    "test": "pnpm -r --filter ./packages/** --filter ./apps/api run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "api:dev": "pnpm --filter @payrecord/api run start:dev",
    "api:worker": "pnpm --filter @payrecord/api run worker",
    "mobile:start": "pnpm --filter @payrecord/mobile run start",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
