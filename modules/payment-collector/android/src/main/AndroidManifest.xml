<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The listener service, boot receiver and permissions are injected into the
       app manifest by app.plugin.js so the app owns the declaration. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Needed to read the wallet app's version/signature via PackageManager on Android 11+. -->
  <queries>
    <package android:name="com.globe.gcash.android" />
    <package android:name="com.gotyme.gotymebank" />
    <package android:name="ph.gotyme.app" />
  </queries>
</manifest>
